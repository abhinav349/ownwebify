generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum ProjectStatus {
  NEW
  REVIEWING
  QUOTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReferralStatus {
  PENDING
  CREDITED
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String?
  role            Role      @default(CLIENT)
  company         String?
  emailVerified   Boolean   @default(false)
  referralCode    String?   @unique
  referralBalance Float     @default(0)
  referredById    String?
  referredBy      User?     @relation("UserReferrals", fields: [referredById], references: [id])
  referrals       User[]    @relation("UserReferrals")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  projects         Project[]
  messages         Message[]
  referralsMade    Referral[] @relation("ReferrerReferrals")
  referralsUsed    Referral[] @relation("RefereeReferrals")
  setupTokens      SetupToken[]
}

model Referral {
  id         String         @id @default(cuid())
  referrerId String
  referrer   User           @relation("ReferrerReferrals", fields: [referrerId], references: [id])
  refereeId  String
  referee    User           @relation("RefereeReferrals", fields: [refereeId], references: [id])
  status     ReferralStatus @default(PENDING)
  amount     Float
  createdAt  DateTime       @default(now())

  @@index([referrerId])
  @@index([refereeId])
}

model Project {
  id              String        @id @default(cuid())
  title           String
  description     String
  projectType     String
  budget          String
  timeline        String
  status          ProjectStatus @default(NEW)
  referenceLinks  String?
  howFoundUs      String?
  features        String[]  @default([])
  clientId        String
  client          User          @relation(fields: [clientId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  quotes   Quote[]
  messages Message[]

  @@index([clientId, createdAt])
  @@index([status])
}

model Quote {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id])
  amount          Float
  currency        String      @default("USD")
  discountPercent Float       @default(0)
  description String
  validUntil  DateTime
  status      QuoteStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId])
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([senderId])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
  @@index([email, createdAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, token])
}

model SetupToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
}

model PortfolioItem {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  longDescription String?
  imageUrl    String?
  techStack   String[]
  liveUrl     String?
  category    String
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  quote     String
  avatarUrl String?
  rating    Int?
  published Boolean  @default(false)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  NOT_INTERESTED
  CONVERTED
}

model Lead {
  id            String     @id @default(cuid())
  businessName  String
  address       String
  phone         String?
  email         String?
  category      String?
  placeId       String     @unique
  website       String?
  mapsUrl       String?
  rating        Float?
  userRatings   Int?
  status        LeadStatus @default(NEW)
  notes         String?
  searchQuery   String?
  emailSentAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Fixed-window rate limit counters.
///
/// Kept in Postgres rather than in process memory because the app runs on
/// serverless functions: an in-memory counter only limits the one instance
/// that happens to serve the request, so an attacker gets a fresh budget on
/// every cold start or fan-out. `key` encodes the bucket (rule + subject,
/// e.g. `login:ip:1.2.3.4`) and is the primary key so the counter can be
/// bumped in a single atomic upsert.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}
